---
// Technische Symbole für Themenkarten und Kästen (eigene Zeichnungen, 24×24, Linienstärke 1,75).
// Verwendung: <Zeichen name="diode" />  – dekorativ, daher aria-hidden.
// Neue Symbole: einfach einen Eintrag in „pfade“ ergänzen (SVG-Pfade im 24er-Raster).
interface Props {
	name: keyof typeof pfade;
}

const pfade = {
	lineal: '<rect x="2" y="8" width="20" height="8" rx="1"/><path d="M6 8v3M10 8v4.5M14 8v3M18 8v4.5"/>',
	buch:'<path d="M3 5.5c3-1.5 6-1.5 9 .5v13c-3-2-6-2-9-.5zM21 5.5c-3-1.5-6-1.5-9 .5v13c3-2 6-2 9-.5z"/>',
	diode: '<path d="M2 12h6M8 6v12l9-6zM17 6v12M17 12h5"/>',
	transistor:
		'<circle cx="13" cy="12" r="8"/><path d="M3 12h6M9 7.5v9M9 10l6-4.5V2M9 14l6 4.5V22"/><path d="M12.6 16.1l2.4 2.4-3.2.4" fill="currentColor"/>',
	opv: '<path d="M6 4v16l13-8zM2 9h4M2 15h4M19 12h3"/>',
	filter: '<path d="M3 3v18h18"/><path d="M4 8h7c3 0 5 5 9 10"/><path d="M11 5v3" stroke-dasharray="1.5 2"/>',
	welle: '<path d="M2 12c2-6.5 4.5-6.5 6.5 0s4.5 6.5 6.5 0 4.5-6.5 6.5 0"/>',
	thermometer: '<path d="M12 3a2 2 0 0 1 2 2v9.2a4 4 0 1 1-4 0V5a2 2 0 0 1 2-2z"/><path d="M12 9v8"/>',
	code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
	drehstrom: '<circle cx="12" cy="12" r="9"/><path d="M12 12V3.5M12 12l7.4 4.3M12 12l-7.4 4.3"/>',
	blitz: '<path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H12z"/>',
	messgeraet: '<path d="M3.5 17a8.5 8.5 0 0 1 17 0"/><path d="M12 17l4.5-6M2 20h20M7 11.5l1 1M12 8.5V10M17 11.5l-1 1"/>',
	streuung: '<path d="M2 20c4 0 5.5-14 10-14s6 14 10 14M2 20h20"/><path d="M12 6v14" stroke-dasharray="1.5 2"/>',
	signal: '<path d="M2 17h3V7h5v10h4V7h5v10h3"/><path d="M2 12h20" stroke-dasharray="1.5 2"/>',
	sensor: '<circle cx="12" cy="14" r="3"/><path d="M12 11V3M7.5 9.5a6 6 0 0 0 0 9M16.5 9.5a6 6 0 0 1 0 9"/>',
	bruecke: '<path d="M12 3l9 9-9 9-9-9zM3 12h18"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/>',
	digital: '<path d="M3 20h4v-4h4v-4h4V8h4V4h2"/>',
	leistung: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M6 14a6 6 0 0 1 12 0M12 14l3-4"/>',
	frequenz: '<path d="M2 14h3V6h5v8h4V6h5v8h3"/><path d="M5 19h9M5 17v4M14 17v4"/>',
	verstaerker: '<path d="M7 5v14l11-7zM2 9h5M2 15h5M18 12h4"/><rect x="2.5" y="10.5" width="3" height="3"/>',
	umsetzer: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M5.5 15c2-6 4-6 6.5 0M13 15h2v-3h2v-3h2"/>',
	motor: '<circle cx="11" cy="12" r="7"/><path d="M18 12h4M8.5 14.5v-5l2.5 3 2.5-3v5"/>',
	regelkreis: '<rect x="8" y="5" width="8" height="6" rx="1"/><path d="M2 8h6M16 8h6M19 8v9H5v-6"/><path d="M3 13l2-2 2 2"/>',
	projekt: '<path d="M4 3v18M4 6h8M7 11h9M10 16h10"/>',
	schaltung: '<path d="M3 7h5M16 7h5M3 17h18M3 7v10M21 7v10"/><rect x="8" y="4.5" width="8" height="5" rx="0.5"/>',
	pruefen: '<path d="M4 12.5l5 5L20 6.5"/>',
	merke: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/>',
	formel: '<path d="M4 4h10l-5 8 5 8H4"/><path d="M16 14l5 5M21 14l-5 5"/>',
	achtung: '<path d="M12 3l10 18H2z"/><path d="M12 10v5M12 18v.5"/>',
	ziel: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>',
} as const;

const { name } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={pfade[name]}
/>
