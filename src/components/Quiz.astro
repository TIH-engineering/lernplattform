---
// Interaktives Quiz. Verwendung in einer .mdx-Seite:
//   import Quiz from '~/components/Quiz.astro';
//   <Quiz id="leistungselektronik" />
// Die Fragen stehen in src/content/quiz/<id>.yaml.
// Es wird nichts gespeichert oder gesendet – alles passiert im Browser.
import { getEntry } from 'astro:content';
import { alsHtml, alsHtmlZeile, zahlDeutsch } from '../lib/text';

interface Props {
	id: string;
}

const eintrag = await getEntry('quiz', Astro.props.id);
if (!eintrag) throw new Error(`Quiz "${Astro.props.id}" nicht gefunden (src/content/quiz/${Astro.props.id}.yaml)`);
// Antwortmöglichkeiten mischen – damit die richtige Antwort nicht immer an derselben Stelle steht.
// Das Mischen ist „zufällig, aber fest“: Es hängt nur vom Fragetext ab, die Reihenfolge
// bleibt also bei jedem Bauen gleich (keine Überraschungen für Lehrende und Lernende).
function zahlAusText(text: string): number {
	let h = 2166136261;
	for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
	return h >>> 0;
}
function mische<T>(liste: T[], startwert: number): T[] {
	const a = [...liste];
	let s = startwert || 1;
	const zufall = () => ((s = Math.imul(s ^ (s >>> 15), 1 | s) + 0x6d2b79f5) >>> 0) / 4294967296;
	for (let i = a.length - 1; i > 0; i--) {
		const j = Math.floor(zufall() * (i + 1));
		[a[i], a[j]] = [a[j], a[i]];
	}
	return a;
}
// Bei Fragen mit genau EINER richtigen Antwort wird die Position der richtigen Antwort
// reihum gleichmäßig verteilt (1., 2., 3., 4. … in gemischter Reihenfolge).
let ziele: number[] = [];
const fragen = eintrag.data.fragen.map((f) => {
	if (f.typ !== 'mc' || !f.mischen) return f;
	const startwert = zahlAusText(f.frage);
	const richtige = f.optionen.filter((o) => o.richtig);
	if (richtige.length !== 1) return { ...f, optionen: mische(f.optionen, startwert) };
	if (ziele.length === 0) ziele = mische([0, 1, 2, 3], startwert);
	const ziel = ziele.shift()! % f.optionen.length;
	const rest = mische(f.optionen.filter((o) => !o.richtig), startwert);
	rest.splice(ziel, 0, richtige[0]);
	return { ...f, optionen: rest };
});

const stufenText = { grundlagen: 'Grundlagen', standard: 'Standard', vertiefung: 'Vertiefung' } as const;
const quizId = `quiz-${Astro.props.id}`;
---

<div class="quiz not-content" id={quizId} data-anzahl={fragen.length}>
	{
		fragen.map((f, i) => {
			const name = `${quizId}-f${i + 1}`;
			const mehrfach = f.typ === 'mc' && f.optionen.filter((o) => o.richtig).length > 1;
			return (
				<section
					class="quiz-frage"
					data-typ={f.typ}
					data-richtig={f.typ === 'mc' ? f.optionen.flatMap((o, j) => (o.richtig ? [j] : [])).join(',') : undefined}
					data-loesung={f.typ === 'zahl' ? f.loesung : undefined}
					data-toleranz={f.typ === 'zahl' ? f.toleranz : undefined}
					data-toleranzart={f.typ === 'zahl' ? f.toleranzArt : undefined}
				>
					<header class="quiz-kopf">
						<span class="quiz-nr" id={`${name}-nr`}>Frage {i + 1} von {fragen.length}</span>
						<span class={`quiz-stufe stufe-${f.stufe}`}>{stufenText[f.stufe]}</span>
					</header>
					<div class="quiz-text" id={`${name}-text`} set:html={alsHtml(f.frage)} />

					{f.typ === 'mc' && (
						<fieldset class="quiz-optionen" aria-labelledby={`${name}-nr ${name}-text`}>
							{mehrfach && <p class="quiz-hinweis">Mehrere Antworten können richtig sein.</p>}
							{f.optionen.map((o, j) => (
								<label class="quiz-option">
									<input type={mehrfach ? 'checkbox' : 'radio'} name={name} value={j} />
									<span set:html={alsHtmlZeile(o.text)} />
								</label>
							))}
						</fieldset>
					)}

					{f.typ === 'zahl' && (
						<div class="quiz-zahl">
							<input
								id={name}
								type="text"
								inputmode="decimal"
								autocomplete="off"
								placeholder="Zahl eingeben"
								aria-labelledby={`${name}-nr ${name}-text`}
								aria-describedby={`${name}-format`}
							/>
							{f.einheit && <span class="quiz-einheit">{f.einheit}</span>}
							<p class="quiz-format" id={`${name}-format`}>
								Nur die Zahl eingeben{f.einheit ? ' – die Einheit steht daneben' : ''}. Komma oder Punkt, z. B. 2,5 oder 2.5.
							</p>
						</div>
					)}

					<div class="quiz-knoepfe">
						<button type="button" class="quiz-pruefen">Antwort prüfen</button>
						<button type="button" class="quiz-nochmal" hidden aria-describedby={`${name}-rueck`}>
							Nochmal versuchen
						</button>
					</div>

					<p class="sr-only quiz-status" role="status" />
					<div class="quiz-rueckmeldung" id={`${name}-rueck`} hidden>
						<p class="quiz-ergebnis" />
						{f.typ === 'zahl' && (
							<p class="quiz-musterloesung">
								Richtige Lösung: <strong>{zahlDeutsch(f.loesung)} {f.einheit}</strong>
								<span class="quiz-tol">
									(akzeptiert: ±{zahlDeutsch(f.toleranz)}
									{f.toleranzArt === 'prozent' ? ' %' : ` ${f.einheit}`})
								</span>
							</p>
						)}
						<div class="quiz-erklaerung" set:html={alsHtml(f.erklaerung)} />
					</div>
				</section>
			);
		})
	}
	<p class="quiz-stand">
		<span>
			Bearbeitet: <strong class="quiz-bearbeitet">0</strong> von {fragen.length} Fragen
			<span class="quiz-stand-richtig" hidden>
				&nbsp;· davon beim ersten Versuch richtig: <strong class="quiz-punkte">0</strong>
			</span>
		</span>
		<!-- Fortschrittsbalken -->
		<span class="quiz-balken" aria-hidden="true"><span></span></span>
	</p>
</div>

<script>
	import { leseZahl, hinweisZuGrund, zahlRichtig, auswahlRichtig } from '../lib/quiz-pruefung.mjs';

	/** true/false = richtig/falsch, sonst ein Hinweistext (keine gültige Eingabe – zählt nicht als Versuch). */
	function pruefe(frage: HTMLElement): boolean | string {
		if (frage.dataset.typ === 'mc') {
			const gewaehlt = [...frage.querySelectorAll<HTMLInputElement>('input:checked')].map((e) => e.value);
			const ok = auswahlRichtig(gewaehlt, (frage.dataset.richtig ?? '').split(','));
			return ok === null ? 'Bitte wähle zuerst eine Antwort.' : ok;
		}
		const eingabe = frage.querySelector<HTMLInputElement>('.quiz-zahl input')!;
		const gelesen = leseZahl(eingabe.value);
		if (gelesen.wert === undefined) return hinweisZuGrund(gelesen.grund);
		return zahlRichtig(
			gelesen.wert,
			Number(frage.dataset.loesung),
			Number(frage.dataset.toleranz),
			frage.dataset.toleranzart,
		);
	}

	function aktualisierePunkte(quiz: HTMLElement) {
		const bearbeitet = quiz.querySelectorAll('.quiz-frage[data-erster]').length;
		const punkte = quiz.querySelectorAll('.quiz-frage[data-erster="richtig"]').length;
		quiz.querySelector('.quiz-bearbeitet')!.textContent = String(bearbeitet);
		quiz.querySelector('.quiz-punkte')!.textContent = String(punkte);
		quiz.querySelector<HTMLElement>('.quiz-stand-richtig')!.hidden = bearbeitet === 0;
		const anteil = (100 * bearbeitet) / Number(quiz.dataset.anzahl || 1);
		quiz.querySelector<HTMLElement>('.quiz-balken > span')?.style.setProperty('--anteil', `${anteil}%`);
	}

	document.querySelectorAll<HTMLElement>('.quiz').forEach((quiz) => {
		quiz.querySelectorAll<HTMLElement>('.quiz-frage').forEach((frage) => {
			const pruefen = frage.querySelector<HTMLButtonElement>('.quiz-pruefen')!;
			const nochmal = frage.querySelector<HTMLButtonElement>('.quiz-nochmal')!;
			const rueck = frage.querySelector<HTMLElement>('.quiz-rueckmeldung')!;
			const ergebnis = frage.querySelector<HTMLElement>('.quiz-ergebnis')!;
			const status = frage.querySelector<HTMLElement>('.quiz-status')!;
			const eingaben = frage.querySelectorAll<HTMLInputElement>('input');

			const auswerten = () => {
				const ok = pruefe(frage);
				if (typeof ok === 'string') {
					ergebnis.textContent = ok;
					status.textContent = ok;
					rueck.hidden = false;
					rueck.dataset.status = 'leer';
					return;
				}
				if (!frage.dataset.erster) {
					frage.dataset.erster = ok ? 'richtig' : 'falsch';
					aktualisierePunkte(quiz);
				}
				frage.dataset.status = ok ? 'richtig' : 'falsch';
				rueck.dataset.status = ok ? 'richtig' : 'falsch';
				ergebnis.textContent = ok ? '✓ Richtig!' : '✗ Leider falsch.';
				status.textContent = ok ? 'Richtig! Die Erklärung steht unter der Frage.' : 'Leider falsch. Die Lösung und die Erklärung stehen unter der Frage.';
				nochmal.textContent = ok ? 'Frage zurücksetzen' : 'Erneut üben';
				rueck.hidden = false;
				eingaben.forEach((e) => (e.disabled = true));
				// Bei Multiple Choice die richtigen Antworten markieren
				if (frage.dataset.typ === 'mc') {
					const richtig = (frage.dataset.richtig ?? '').split(',');
					frage.querySelectorAll<HTMLLabelElement>('.quiz-option').forEach((l) => {
						const inp = l.querySelector('input')!;
						if (richtig.includes(inp.value)) l.dataset.markierung = 'richtig';
						else if (inp.checked) l.dataset.markierung = 'falsch';
					});
				}
				pruefen.hidden = true;
				nochmal.hidden = false;
				nochmal.focus();
			};

			pruefen.addEventListener('click', auswerten);
			frage.querySelector('.quiz-zahl input')?.addEventListener('keydown', (e) => {
				if ((e as KeyboardEvent).key === 'Enter') auswerten();
			});

			nochmal.addEventListener('click', () => {
				eingaben.forEach((e) => {
					e.disabled = false;
					if (e.type === 'text') e.value = '';
					else e.checked = false;
				});
				frage.querySelectorAll<HTMLElement>('.quiz-option').forEach((l) => delete l.dataset.markierung);
				delete frage.dataset.status;
				status.textContent = '';
				rueck.hidden = true;
				nochmal.hidden = true;
				pruefen.hidden = false;
				(eingaben[0] as HTMLElement | undefined)?.focus();
			});
		});
	});
</script>

<style>
	/* Quiz im Designsystem „Modern Technical Education“ (Farben aus src/styles/ds.css) */
	.quiz {
		display: grid;
		gap: 1rem;
		margin-block: 1.5rem;
	}
	.quiz-frage {
		padding: 1.25rem 1.35rem;
		border: 1px solid var(--ds-linie);
		border-radius: var(--ds-radius);
		background: var(--ds-flaeche);
		box-shadow: var(--ds-schatten);
	}
	.quiz-frage[data-status='richtig'] {
		border-color: var(--ds-tuerkis);
		box-shadow: inset 4px 0 0 var(--ds-tuerkis), var(--ds-schatten);
	}
	.quiz-frage[data-status='falsch'] {
		border-color: var(--ds-rot);
		box-shadow: inset 4px 0 0 var(--ds-rot), var(--ds-schatten);
	}
	.quiz-kopf {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--ds-text-leise);
	}
	.quiz-nr {
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}
	.quiz-stufe {
		font-size: var(--sl-text-xs);
		font-weight: 600;
		padding: 0.1rem 0.5rem;
		border-radius: 0.25rem;
		border: 1px solid;
	}
	.stufe-grundlagen {
		color: var(--sl-color-green-high);
		background: var(--sl-color-green-low);
		border-color: var(--sl-color-green);
	}
	.stufe-standard {
		color: var(--sl-color-orange-high);
		background: var(--sl-color-orange-low);
		border-color: var(--sl-color-orange);
	}
	.stufe-vertiefung {
		color: var(--sl-color-red-high);
		background: var(--sl-color-red-low);
		border-color: var(--sl-color-red);
	}
	.quiz-text :global(p) {
		margin: 0 0 0.85rem;
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		line-height: 1.5;
		font-weight: 600;
	}
	.quiz-optionen {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		border: 0;
	}
	.quiz-hinweis {
		margin: 0 0 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--ds-text-leise);
	}
	.quiz-option {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--ds-linie);
		border-radius: var(--ds-radius-klein);
		background: var(--ds-flaeche-2);
		cursor: pointer;
	}
	.quiz-option:hover {
		border-color: var(--ds-petrol);
	}
	.quiz-option:has(input:checked) {
		border-color: var(--ds-petrol);
		background: var(--ds-ton-petrol);
	}
	.quiz-option input {
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		margin: 0;
		accent-color: var(--ds-petrol);
	}
	/* Markierung nach dem Prüfen – steht nach :has(input:checked) und ist gleich spezifisch, gewinnt also */
	.quiz-option:has(input)[data-markierung='richtig'] {
		border-color: var(--ds-tuerkis);
		background: var(--ds-ton-tuerkis);
	}
	.quiz-option:has(input)[data-markierung='falsch'] {
		border-color: var(--ds-rot);
		background: var(--ds-ton-rot);
	}
	/* Zusätzlich zur Farbe ein Wort, damit richtig/falsch nicht nur über die Farbe erkennbar ist */
	.quiz-option[data-markierung]::after {
		margin-left: auto;
		padding-left: 0.75rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.quiz-option[data-markierung='richtig']::after {
		content: '✓ richtig';
		color: var(--ds-tuerkis);
	}
	.quiz-option[data-markierung='falsch']::after {
		content: '✗ gewählt';
		color: var(--ds-rot);
	}
	.quiz-zahl {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	.quiz-zahl input {
		width: 10rem;
		max-width: 60%;
		padding: 0.55rem 0.75rem;
		font: inherit;
		color: var(--sl-color-white);
		background: var(--ds-flaeche-2);
		border: 1px solid var(--ds-linie);
		border-radius: var(--ds-radius-klein);
	}
	.quiz-einheit {
		font-weight: 600;
	}
	.quiz-format {
		flex-basis: 100%;
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--ds-text-leise);
	}
	/* Sichtbarer Fokus für die Bedienung mit der Tastatur */
	.quiz-option:has(input:focus-visible),
	.quiz-knoepfe button:focus-visible,
	.quiz-zahl input:focus-visible {
		outline: 2px solid var(--ds-petrol);
		outline-offset: 2px;
	}
	.quiz-knoepfe {
		margin-top: 0.9rem;
	}
	.quiz-knoepfe button {
		padding: 0.5rem 1.15rem;
		border: 1px solid var(--ds-petrol);
		border-radius: var(--ds-radius-klein);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.quiz-pruefen {
		background: var(--ds-petrol);
		color: var(--sl-color-black);
	}
	:global([data-theme='light']) .quiz-pruefen {
		color: #fff;
	}
	.quiz-nochmal {
		background: transparent;
		color: var(--ds-petrol-stark);
	}
	.quiz-rueckmeldung {
		margin-top: 1rem;
		padding: 0.85rem 1rem;
		border-radius: var(--ds-radius-klein);
		background: var(--ds-flaeche-2);
	}
	.quiz-rueckmeldung[data-status='richtig'] {
		background: var(--ds-ton-tuerkis);
	}
	.quiz-rueckmeldung[data-status='falsch'] {
		background: var(--ds-ton-rot);
	}
	.quiz-rueckmeldung[data-status='leer'] {
		background: var(--ds-ton-bernstein);
	}
	.quiz-ergebnis {
		margin: 0 0 0.4rem;
		font-weight: 700;
	}
	.quiz-rueckmeldung[data-status='richtig'] .quiz-ergebnis {
		color: var(--ds-tuerkis);
	}
	.quiz-rueckmeldung[data-status='falsch'] .quiz-ergebnis {
		color: var(--ds-rot);
	}
	.quiz-rueckmeldung[data-status='leer'] .quiz-musterloesung,
	.quiz-rueckmeldung[data-status='leer'] .quiz-erklaerung {
		display: none;
	}
	.quiz-musterloesung {
		margin: 0 0 0.4rem;
	}
	.quiz-tol {
		font-size: var(--sl-text-sm);
		color: var(--ds-text-leise);
	}
	.quiz-erklaerung :global(p) {
		margin: 0.25rem 0;
	}
	/* Fortschritt: auf großen Bildschirmen unten mitlaufend, auf dem Handy am Ende (würde sonst Erklärungen verdecken) */
	.quiz-stand {
		position: sticky;
		bottom: 0.75rem;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin: 0;
		padding: 0.7rem 1rem;
		border: 1px solid var(--ds-linie);
		border-radius: var(--ds-radius);
		background: var(--ds-flaeche);
		box-shadow: var(--ds-schatten);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	@media (max-width: 50rem) {
		.quiz-stand {
			position: static;
		}
	}
	.quiz-balken {
		display: block;
		flex: 1 1 10rem;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--ds-linie);
		overflow: hidden;
	}
	.quiz-balken > span {
		display: block;
		height: 100%;
		width: var(--anteil, 0%);
		background: var(--ds-petrol);
		transition: width 0.2s;
	}
	@media (prefers-reduced-motion: reduce) {
		.quiz-balken > span {
			transition: none;
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
